{
    "name": "backend",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile ./build/server src/index.ts",
        "dev": "bun run --watch src/index.ts",
        "compile": "tsc --noEmit",
        "lint": "eslint . --fix",
        "format": "prettier --write ./src --list-different"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.0",
        "@elysiajs/openapi": "^1.4.11",
        "better-auth": "^1.4.1",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.44.7",
        "drizzle-typebox": "^0.3.3",
        "elysia": "latest",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "minio": "^8.0.6",
        "pg": "^8.16.3",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.2",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/pg": "^8.15.6",
        "bun-types": "1.3.3",
        "drizzle-kit": "^0.31.7",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0"
